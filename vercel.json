{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/analyzer.mjs": {
      "includeFiles": "{data/7.42/*.json,workers/*.mjs}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/analyzer?__analyzerPath=/api/:path*" },
    { "source": "/assets/:path*", "destination": "/api/analyzer?__analyzerPath=/assets/:path*" }
  ]
}
